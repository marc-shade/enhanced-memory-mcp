# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repository root on purpose. The conventional unanchored
# "lib/" matches a directory named lib at ANY depth, which silently excluded
# every file under setup/lib/ (the installer's shared shell and probe helpers).
# A clone would have had a setup.sh that sources a file git never shipped.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Local data (not for publishing)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Archives and backups
.archive/
*.backup
*.bak
~

# Environment and secrets
.env
.env.local
*.pem
*.key

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime-generated tool registry. sandbox/tool_discovery.py writes this tree
# from whatever the installation declares via MEMORY_TOOL_REGISTRY_FILE, so it
# is per-install state, not source. Committing it is how this repository came
# to advertise five MCP servers that did not exist: list_servers() reports the
# directory names it finds here, so a checked-in tree makes claims on behalf of
# every future clone.
tool_registry/

# Scratch data directory used by local verification runs. Its contents are
# already covered by *.db / *.log, but only incidentally -- name it so a stray
# file of another type cannot slip in.
.tmpdata/

# Literal path artifacts: directories named for an unexpanded shell variable,
# created when a script runs with the variable unset. Patterns are literal in
# gitignore; there is no expansion here.
$HOME/
${AGENTIC_SYSTEM_PATH:-*
/~/
