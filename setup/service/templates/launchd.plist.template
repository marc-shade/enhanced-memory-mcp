<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by setup/service/install-services.sh from
  setup/service/templates/launchd.plist.template. Edits here are overwritten on
  the next install; change the template or the .env instead.

  Log paths deliberately point at ~/Library/Logs and never at the checkout: when
  a checkout lives on an external or network volume, launchd cannot create the
  stdout file at spawn time and the job dies with exit code 78 before the program
  runs, with nothing written anywhere to say why.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <key>ProgramArguments</key>
    <array>
        <string>@EXEC@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@LOGDIR@/@LABEL@.out.log</string>

    <key>StandardErrorPath</key>
    <string>@LOGDIR@/@LABEL@.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!--
          launchd agents start with a minimal PATH. The launchers need to find
          uname, mkdir and friends; the python interpreter itself is addressed by
          absolute path, and every other setting comes from the checkout's .env.
        -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
