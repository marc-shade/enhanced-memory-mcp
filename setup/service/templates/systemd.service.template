# Generated by setup/service/install-services.sh from
# setup/service/templates/systemd.service.template. Edits here are overwritten on
# the next install; change the template or the .env instead.
#
# This is a USER unit (systemctl --user). It needs no root, and it stops when you
# log out unless lingering is enabled for your account:
#
#     loginctl enable-linger $USER
#
# Environment comes from the checkout's .env, which the launcher sources. Do not
# add EnvironmentFile= here: it would give this unit a second, independently
# parsed view of the same settings, and the daemon and the MCP server disagreeing
# about the database path is the failure this project is most prone to.

[Unit]
Description=@DESC@
Documentation=file://@REPO@/README.md
After=network.target

[Service]
Type=simple
ExecStart=@EXEC@
Restart=on-failure
RestartSec=10
WorkingDirectory=@REPO@
StandardOutput=append:@LOGDIR@/@LABEL@.out.log
StandardError=append:@LOGDIR@/@LABEL@.err.log

# Modest hardening. The daemon needs to write the database under $HOME and the
# socket under /tmp, so ProtectHome and PrivateTmp stay off on purpose.
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=default.target
