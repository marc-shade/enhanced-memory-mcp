# Enhanced Memory MCP - environment configuration
#
# Copy to .env (setup/setup.sh does this for you) and edit. Every value below is
# the code's own default, so an unedited .env behaves exactly like no .env at all.
#
# Precedence: a variable already set in the environment beats this file. So
# `MEMORY_DB_SOCKET_PATH=/tmp/other.sock ./healthcheck.sh` overrides the value
# here for that one run, and a container runtime's environment wins without an
# image rebuild.
#
# ---------------------------------------------------------------------------
# READ THIS FIRST: this file must reach BOTH processes
# ---------------------------------------------------------------------------
# Enhanced Memory runs as TWO processes:
#
#   1. memory_db_service.py  the Unix-socket daemon that owns the SQLite file
#   2. server.py             the MCP server your client talks to
#
# The database-path variables are read INDEPENDENTLY by each process. If the
# daemon resolves one path and the MCP server resolves another, nothing errors:
# the server writes through the socket to database A while reporting statistics
# from database B. That is a silent split brain, and it is the single most
# common misconfiguration of this system.
#
# The launcher scripts (setup/bin/memory-db-daemon.sh and setup/bin/mcp-server.sh)
# both source this one file, which is why the README tells your MCP client to
# invoke setup/bin/mcp-server.sh rather than python server.py directly. If you
# bypass the launchers, you own keeping the two environments identical.
#
# ./healthcheck.sh check 3 compares the two resolved paths and fails on mismatch.
# ---------------------------------------------------------------------------


# === Core: storage =========================================================

# Directory holding memory.db. Created if missing.
# Default: ~/.claude/enhanced_memories
ENHANCED_MEMORY_DIR="$HOME/.claude/enhanced_memories"

# Full path to the database file. Takes precedence over ENHANCED_MEMORY_DIR when
# set; leave commented unless you need the file somewhere other than
# $ENHANCED_MEMORY_DIR/memory.db.
# ENHANCED_MEMORY_DB_PATH="$HOME/.claude/enhanced_memories/memory.db"

# MEMORY_DIR / MEMORY_DB_PATH are accepted as legacy aliases for the two above.
# Do not set both spellings: ENHANCED_MEMORY_* wins and the other is ignored.


# === Core: the daemon socket ===============================================

# Unix socket the daemon listens on and the MCP server dials.
# Default: /tmp/memory-db.sock
#
# AF_UNIX PATH LIMIT: the kernel caps socket paths at 104 bytes on macOS and 108
# on Linux. This is a hard cap on the PATH STRING, not on your filesystem. Put
# the socket under a deep checkout (say
# /Users/you/work/clients/acme/vendor/enhanced-memory-mcp/run/memory-db.sock) and
# the daemon dies at bind() with a bare OSError that names neither the limit nor
# the path. Keep it short and outside the checkout. setup/setup.sh measures the
# resolved length and refuses to continue if it is too long.
#
# Running two checkouts side by side? Give each its own SHORT path, for example
# /tmp/em-acme.sock, rather than moving the socket into the checkout.
MEMORY_DB_SOCKET_PATH="/tmp/memory-db.sock"


# === Core: MCP transport ===================================================

# stdio (default) launches one server process per client, which is what Claude
# Code and Claude Desktop expect. sse / streamable-http run a shared HTTP daemon
# instead, which is what the container image uses.
# Values: stdio | sse | streamable-http
MCP_TRANSPORT="stdio"

# Only consulted when MCP_TRANSPORT is not stdio.
# Keep MCP_HOST at 127.0.0.1 on a workstation: 0.0.0.0 publishes an unauthenticated
# memory server to your whole network. The container image sets 0.0.0.0 inside the
# container on purpose (that is how a published port works) and compose.yaml binds
# the host side back to 127.0.0.1.
MCP_HOST="127.0.0.1"
MCP_PORT="9106"


# === Core: tool surface ====================================================

# Which tools the MCP server exposes and how eagerly the client loads schemas.
#   frontdoor    (default) register everything, mark a small always-loaded set
#                (search_nodes, semantic_recall, create_entities,
#                get_memory_status, execute_code), leave the tail deferred for
#                the client's ToolSearch
#   consolidated register 7 tools and hide the rest behind memory_call
#   full         register everything, mark nothing
ENHANCED_MEMORY_SURFACE="frontdoor"

# full (default) loads every optional integration. minimal skips them and starts
# noticeably faster; use it when you only need core memory operations.
# Values: full | minimal | codex | gemini
MEMORY_PROFILE="full"


# === Optional: declaring OTHER MCP servers to sandboxed code ===============
#
# Code running inside the execute_code tool can ask which other MCP servers it
# may call. By default the answer is NOTHING, and that default is deliberate:
# this package cannot know what your machine runs, so claiming otherwise would
# hand agent code a list of tools that are not there. Earlier versions shipped a
# fixed list of six servers, five of which do not exist in a standalone install.
#
# To declare the servers you actually run, point this at a JSON file mapping
# server name to a list of tool objects:
#
#   {"my-server": [{"name": "do_thing",
#                   "description": "what it does",
#                   "parameters": {"x": "str"},
#                   "returns": "what comes back",
#                   "cost_estimate": "low"}]}
#
# A missing, unreadable or non-object file declares nothing and logs the reason;
# it never fails quietly. Directories written directly under tool_registry/ in
# the checkout are reported as well, so you can declare servers that way instead.
# MEMORY_TOOL_REGISTRY_FILE=""


# === Optional: Qdrant (vector recall) ======================================
#
# Absent Qdrant, search still works: it degrades from semantic to lexical. You
# get keyword matches and lose "find me the thing that MEANS this". Nothing
# errors, which is exactly why it is worth checking on purpose.
# Provision with: setup/setup.sh --with-qdrant

MEMORY_QDRANT_URL="http://localhost:6333"
# Collection name. Leave unset to use the code's derived default.
# MEMORY_QDRANT_COLLECTION=""


# === Optional: Ollama (embeddings) =========================================
#
# Embeddings for semantic recall are generated locally by Ollama. Without it,
# Qdrant has nothing to index and recall stays lexical even if Qdrant is up.
# Provision with: setup/setup.sh --with-ollama

MEMORY_OLLAMA_URL="http://127.0.0.1:11434"
MEMORY_EMBED_MODEL="embeddinggemma"

# Confidence below which a search result is flagged low_confidence.
MEMORY_LOW_CONF_THRESHOLD="0.50"


# === Optional: cluster identity ============================================

# Identifies this machine in memory records shared across several machines.
# Defaults to the system hostname. Single-machine installs can ignore it.
# NODE_ID=""


# === Optional: third-party API keys ========================================
#
# None of these are required. Each unlocks one optional feature and its absence
# disables that feature rather than breaking the server. Never commit real keys:
# .env is gitignored, .env.example is not.

# ANTHROPIC_API_KEY=""   # LLM-generated contextual prefixes for RAG indexing
# OPENAI_API_KEY=""      # alternative embedding/LLM provider
# GOOGLE_API_KEY=""      # alternative LLM provider


# === Healthcheck knobs =====================================================
#
# Number of tools ./healthcheck.sh expects from tools/list. Unset means "report
# the count and warn that it is unpinned" rather than "pass silently". Pin it
# once you know the number for your configuration, because the count changes
# with ENHANCED_MEMORY_SURFACE, MEMORY_PROFILE, and which optional backends are
# installed: measured 188 core / 206 with requirements-optional.txt, on Python
# 3.11.11 at the default surface and profile.
# EXPECTED_TOOL_COUNT="188"
